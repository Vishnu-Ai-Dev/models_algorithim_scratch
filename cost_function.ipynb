   "source": [
    "def compute_cost(x,y,w,b):\n",
    "    m=x.shape[0]\n",
    "    cost_sum=0\n",
    "    i=1\n",
    "    f_wb=w*x+b\n",
    "    cost_fun=f_wb-y[i]\n",
    "    cost_sum+=cost_fun**2\n",
    "    total_cost=cost_sum/(2*m)\n",
    "    return total_cost"
   ]
  }
