   "source": [
    "def sigmoid(z):\n",
    "    return 1/(1+np.exp(-z))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "73a26e42",
   "metadata": {},
   "outputs": [],
   "source": [
    "def dense(a_in,w,b):\n",
    "    z=np.matmul(w,a_in)+b\n",
    "    aout=sigmoid(z)\n",
    "    return aout"
   ]
  }
