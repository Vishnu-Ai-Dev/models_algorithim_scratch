   "source": [
    "def compute_gradient_reg(X, y, w, b, lambda_=1):\n",
    "\n",
    "    m, n = X.shape\n",
    "\n",
    "    dj_db, dj_dw = compute_gradient(X, y, w, b)\n",
    "\n",
    "    for j in range(n):\n",
    "        dj_dw[j] += (lambda_ / m) * w[j]\n",
    "\n",
    "    return dj_db, dj_dw"
   ]
  }
